@page "/nosotros"

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-5">
    <MudText Typo="Typo.h3" Align="Align.Center" Color="Color.Primary" Class="mb-4">Sobre Nosotros</MudText>
    <MudPaper Elevation="2" Class="pa-5 mb-5 text-center">
        <MudIcon Icon="@Icons.Material.Filled.Spa" Color="Color.Secondary" Size="Size.Large" Class="mb-3" />
        <MudText Typo="Typo.h5" GutterBottom="true">Bienvenidos a MOER Estética</MudText>
        <MudText Typo="Typo.body1">
            Somos un centro dedicado a tu bienestar y belleza. (Texto de relleno: Aquí irá la historia del local, la misión, la visión y una foto del equipo o del establecimiento).
        </MudText>
    </MudPaper>
</MudContainer>

