@page "/admin/pedidos"
@using MOERSitioWeb.DTOs
@using MOERSitioWeb.Services
@inject PedidoService PedidoService
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Administrador")]

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-5">
    <MudText Typo="Typo.h4" GutterBottom="true" Color="Color.Primary">Gestión de Pedidos E-commerce</MudText>

    @if (pedidos == null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (!pedidos.Any())
    {
        <MudAlert Severity="Severity.Info">No hay pedidos registrados.</MudAlert>
    }
    else
    {
        <MudTable Items="@pedidos" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="4">
            <HeaderContent>
                <MudTh></MudTh> <!-- Columna vacía para el botón de expandir -->
                <MudTh>ID</MudTh>
                <MudTh>Fecha</MudTh>
                <MudTh>Cliente</MudTh>
                <MudTh>Total</MudTh>
                <MudTh>Estado Logístico</MudTh>
                <MudTh>Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudIconButton Icon="@(context.MostrarDetalles ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                   OnClick="@(() => context.MostrarDetalles = !context.MostrarDetalles)" />
                </MudTd>
                <MudTd DataLabel="ID">#@context.IdPedido</MudTd>
                <MudTd DataLabel="Fecha">@context.Fecha.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Cliente">@context.ClienteNombre</MudTd>
                <MudTd DataLabel="Total">$@context.Total</MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Color="@GetEstadoColor(context.Estado)" Size="Size.Small">@context.Estado</MudChip>
                </MudTd>
                <MudTd DataLabel="Acciones">
                    @if (context.Estado == "Pendiente")
                    {
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" AnchorOrigin="Origin.BottomRight">
                            <MudMenuItem OnClick="@(() => CambiarEstado(context.IdPedido, 2))" Icon="@Icons.Material.Filled.Inventory2" IconColor="Color.Info">Listo para retiro</MudMenuItem>
                            <MudMenuItem OnClick="@(() => CambiarEstado(context.IdPedido, 4))" Icon="@Icons.Material.Filled.Cancel" IconColor="Color.Error">Cancelar</MudMenuItem>
                        </MudMenu>
                    }
                    else if (context.Estado == "Listo para Retiro")
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" OnClick="@(() => CambiarEstado(context.IdPedido, 3))">Marcar Entregado</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <ChildRowContent>
                @if (context.MostrarDetalles)
                {
                    <MudTr>
                        <td colspan="7">
                            <MudCard Elevation="0" Class="pa-4" Style="background-color: #fafafa;">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">Detalle de Productos a Preparar:</MudText>
                                <MudSimpleTable Dense="true" Hover="false" Bordered="false" Striped="true" Style="overflow-x: auto;">
                                    <thead>
                                        <tr>
                                            <th>Producto</th>
                                            <th>Cantidad</th>
                                            <th>Precio Unit.</th>
                                            <th>Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var detalle in context.Detalles)
                                        {
                                            <tr>
                                                <td>@detalle.Producto</td>
                                                <td>@detalle.Cantidad</td>
                                                <td>$@detalle.PrecioUnitario</td>
                                                <td>$@detalle.Subtotal</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            </MudCard>
                        </td>
                    </MudTr>
                }
            </ChildRowContent>
        </MudTable>
    }
</MudContainer>

@code {
    // Extendemos el DTO solo para manejar el estado visual de "abierto/cerrado" en la tabla
    public class PedidoUI : PedidoResponseDTO
    {
        public bool MostrarDetalles { get; set; } = false;
    }

    private List<PedidoUI> pedidos;

    protected override async Task OnInitializedAsync()
    {
        await CargarPedidos();
    }

    private async Task CargarPedidos()
    {
        var data = await PedidoService.GetTodosLosPedidos();
        // Mapeamos al modelo de UI
        pedidos = data.Select(p => new PedidoUI
        {
            IdPedido = p.IdPedido,
            Fecha = p.Fecha,
            Estado = p.Estado,
            Total = p.Total,
            ClienteNombre = p.ClienteNombre,
            ClienteTelefono = p.ClienteTelefono,
            Detalles = p.Detalles
        }).ToList();
    }

    private async Task CambiarEstado(int idPedido, int idNuevoEstado)
    {
        var dto = new PedidoEstadoUpdateDTO { IdEstadoPedido = idNuevoEstado };
        var response = await PedidoService.ActualizarEstadoPedido(idPedido, dto);

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Estado del pedido actualizado.", Severity.Success);
            await CargarPedidos();
        }
        else
        {
            Snackbar.Add("Error al actualizar el estado.", Severity.Error);
        }
    }

    private Color GetEstadoColor(string estado) => estado switch
    {
        "Pendiente" => Color.Warning,
        "Listo para Retiro" => Color.Info,
        "Entregado" => Color.Success,
        "Cancelado" => Color.Error,
        _ => Color.Default
    };
}