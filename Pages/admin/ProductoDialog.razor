@using MudBlazor
@using MOERSitioWeb.DTOs
@using MOERSitioWeb.Services
@inject CategoriaService CategoriaSvc

<MudDialog>
    <DialogContent>
        <EditForm Model="@dto" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="dto.Nombre" Label="Nombre" For="@(() => dto.Nombre)" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="dto.Descripcion" Label="Descripción" Lines="3" Variant="Variant.Outlined" Class="mb-3" />

            <div class="d-flex gap-4 mb-3">
                <MudNumericField @bind-Value="dto.Precio" Label="Precio" Format="N2" Min="0.01m" Variant="Variant.Outlined" For="@(() => dto.Precio)" />
                @if (EsNuevo)
                {
                    <MudNumericField @bind-Value="dto.StockActual" Label="Stock Inicial" Min="0" Variant="Variant.Outlined" For="@(() => dto.StockActual)" />
                }
            </div>

            <MudSelect T="int" Label="Categoría" @bind-Value="dto.IdCategoriaProducto" For="@(() => dto.IdCategoriaProducto)" Variant="Variant.Outlined">
                <MudSelectItem Value="0" Disabled="true">Seleccione una categoría</MudSelectItem>
                @if (categorias != null)
                {
                    @foreach (var cat in categorias)
                    {
                        <MudSelectItem Value="@cat.IdCategoriaProducto">@cat.Nombre</MudSelectItem>
                    }
                }
            </MudSelect>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Guardar">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public ProductoCreateDTO dto { get; set; } = new();
    [Parameter] public bool EsNuevo { get; set; } = true;

    private List<CategoriaResponseDTO> categorias = new();

    protected override async Task OnInitializedAsync()
    {
        categorias = await CategoriaSvc.GetCategoriasProductos();
    }

    private void Guardar()
    {
        if (dto.IdCategoriaProducto == 0 || string.IsNullOrWhiteSpace(dto.Nombre)) return;
        MudDialog.Close(DialogResult.Ok(dto));
    }

    private void Cancelar() => MudDialog.Cancel();
}